# UFW-GUI Configuration
# MANDATORY: Generate a unique 32+ character hex string: openssl rand -hex 32
UFW_GUI_SECRET_KEY=

# New installations only: use a different, randomly generated 32+ character token.
# Remove it from the environment after creating the first administrator.
UFW_GUI_SETUP_TOKEN=

# Loopback by default. Exposing another interface requires a trusted TLS boundary.
UFW_GUI_BIND_ADDRESS=127.0.0.1

# Optional: Comma-separated list of allowed origins for CORS
# Example: https://dash.srvrs.top,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# TZ for logging
TZ=Europe/Kyiv
